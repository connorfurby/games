# Supabase (project "games") — copy to .env.local for Vite.
# Also set these on Vercel for production builds.
VITE_SUPABASE_URL=https://xfolpeegsguifkyewdvx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google OAuth (Supabase dashboard → Authentication):
# 1. Providers → Google: enable, paste Client ID + Secret from Google Cloud.
# 2. URL Configuration:
#    Site URL = the exact origin you play on, e.g. http://127.0.0.1:5181
#      (NOT localhost:3000 — that is why the return after Google failed.)
#    Redirect URLs must include every origin you use, e.g.:
#      http://127.0.0.1:5181/**
#      http://localhost:5173/**
#      http://127.0.0.1:5173/**
#      https://your-app.vercel.app/**
# 3. Google Cloud OAuth client → Authorized redirect URIs:
#      https://xfolpeegsguifkyewdvx.supabase.co/auth/v1/callback
# Google’s account picker will show that supabase.co host until you add a
# custom Auth domain in Supabase (optional paid feature). Disable email signups.
